# https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash
# Userbot session file path (creates data/peace_userbot.session) — grants full account access, never commit!
TG_SESSION_NAME=data/peace_userbot

# @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# https://alerts.in.ua (token requested via form) — optional
ALERTS_API_TOKEN=

DB_PATH=data/peace.db
# Threats persist until new info (partial clear / all clear) and do not expire by timer.
# After this many minutes without updates for a district, a staleness notice is shown.
STALE_AFTER_MINUTES=30
# Minimum combined source confidence (0..1) to mark an alert as confirmed
MIN_CONFIDENCE=0.6

# Your Telegram chat id (send /id to the bot to learn it): receives source-failure notices, may use /debug
ADMIN_CHAT_ID=0
# Night mode (Kyiv time): users with night mode on get pushes only for red alerts and all-clears
QUIET_START_HOUR=23
QUIET_END_HOUR=7
# Seconds to collect changes into a single notification (also lets other channels confirm)
BATCH_SECONDS=4
