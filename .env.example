# https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash
# файл сессии userbot (будет data/peace_userbot.session) — это полный доступ к аккаунту, не публикуйте!
TG_SESSION_NAME=data/peace_userbot

# @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# https://alerts.in.ua (токен выдают по запросу) — опционально
ALERTS_API_TOKEN=

DB_PATH=data/peace.db
# Угроза держится до новой информации (снятие / отбой) и не истекает по времени.
# Через столько минут без новостей по району пользователь увидит пометку «без оновлень N хв»
STALE_AFTER_MINUTES=30
# минимальное доверие, чтобы показать информацию пользователю (0..1)
MIN_CONFIDENCE=0.6
