# Optional remote SSH deployment settings for ./deploy.sh
# Only needed when deploying from your local PC over SSH.
# Not needed when running ./deploy.sh directly on the VPS.

VPS_HOST=1.2.3.4            # VPS IP or hostname
VPS_USER=root               # SSH user on VPS
VPS_PORT=22                 # SSH port
VPS_DIR=/opt/Peace          # Project path on VPS
BRANCH=main                 # Branch to deploy
