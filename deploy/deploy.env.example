# Настройки деплоя для ./deploy.sh
# Скопируйте в deploy/deploy.env и заполните (deploy.env в .gitignore).

VPS_HOST=1.2.3.4            # IP или домен VPS
VPS_USER=peace              # пользователь на VPS
VPS_PORT=22                 # SSH-порт
VPS_DIR=Project_PEACE       # путь к проекту на VPS (относительно home или абсолютный)
BRANCH=main                 # ветка, которая деплоится
